---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Home | My Site">
  <div class="mx-auto text-center flex flex-col space-x-3">
    <!-- This wraps everything into one centered box -->
    <h1 class="text-4xl font-bold mb-4">Stuns</h1>
    <p class="text-lg text-slate-600 dark:text-zinc-400 mb-8">
      Available now on the App Store
    </p>

    <p>
      KEY FEATURES: Today at a Glance: A streamlined dashboard showing your most
      important metrics right now. No noise, just the essentials. Monthly Deep
      Dives: Go beyond the daily grind. View your progress over the last 30 days
      with high-performance interactive charts. Trend Analysis: The ultimate
      "reality check." Automatically compare this month's data against the
      previous month to see if you’re actually improving or need to adjust your
      training load.
    </p>

    <div class="flex flex-col space-x-3 mt-6">
      <a href="stuns/privacy-policy" class="hover:underline text-blue-400"
        >Privacy Policy</a
      >

      <a href="stuns/support" class="hover:underline text-blue-400">Contact</a>
    </div>
  </div>
</MainLayout>
